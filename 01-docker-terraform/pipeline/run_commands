  --name pgadmin \
  dpage/pgadmin4

  #fix network connection issue(eg. pgadmin cant connect(timed out) with pgdatabase etc.)
  docker compose ps
  
  pgadmin_id=$(docker compose ps -q pgadmin)
  network=$(docker inspect "$pgadmin_id" \
    --format '{{range $name, $net := .NetworkSettings.Networks}}{{println $name}}{{end}}' |
    head -n1)
  bridge="br-$(docker network inspect --format '{{.Id}}' "$network" | cut -c1-12)"

  echo "Compose network: $network; bridge: $bridge"

  docker run --rm --network="$network" postgres:18 \
